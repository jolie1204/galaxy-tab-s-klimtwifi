+static void klimt_exec_observed(void *unused, struct task_struct *task, pid_t old_pid,
+				struct linux_binprm *bprm)
+{
+	const char *path = bprm->filename;
+	const char *domain;
+	const char *label;
+	int *actor;
+
+	if (!strcmp(path, "/apex/com.android.art/bin/art_boot")) {
+		domain = "u:r:art_boot:s0";
+		label = "art_boot";
+		actor = &klimt_boot_pid;
+	} else if (!strcmp(path, "/apex/com.android.art/bin/odrefresh")) {
+		domain = "u:r:odrefresh:s0";
+		label = "odrefresh";
+		actor = &klimt_odrefresh_pid;
+	} else {
+		return;
+	}
+	if (enforcing_enabled() && klimt_in_domain(domain) &&
+	    current->nsproxy->mnt_ns == READ_ONCE(klimt_default_ns)) {
+		WRITE_ONCE(*actor, task->tgid);
+		pr_notice("KLIMT-ART exec=%s pid=%d domain=%s enforcing=1\n",
+			  label, task->tgid, domain);
+	}
+}
+
+static int __init klimt_exec_observer_init(void)
+{
+	return register_trace_sched_process_exec(klimt_exec_observed, NULL);
+}
+late_initcall(klimt_exec_observer_init);
+
+static bool klimt_cache_absent(void)
+{
+	static const char name[] = "/data/misc/apexdata/com.android.art/dalvik-cache/cache-info.xml";
+	struct path path;
+	int err = kern_path(name, LOOKUP_NO_SYMLINKS, &path);
+
+	if (!err)
+		path_put(&path);
+	return err == -ENOENT;
+}
+
+static void klimt_art_before(struct callback_head *work)
+{
+	bool cache_absent = klimt_cache_absent();
+	bool clean = klimt_cp_ok && klimt_ram_data() && cache_absent &&
+		     !READ_ONCE(klimt_boot_pid) && !READ_ONCE(klimt_odrefresh_pid);
+
+	pr_notice("KLIMT-ART clean=%u cp=%u cache_absent=%u\n", clean, klimt_cp_ok, cache_absent);
+	if (!clean)
+		klimt_finish();
+}
+
+static void klimt_art_after(struct callback_head *work)
+{
+	pr_notice("KLIMT-ART checked run=%s art_pid=%d odr_pid=%d flags=%u ram=%u cache_absent=%u enforcing=%u\n",
+		  klimt_run, READ_ONCE(klimt_boot_pid), READ_ONCE(klimt_odrefresh_pid),
+		  klimt_art_ready, klimt_ram_data(), klimt_cache_absent(), enforcing_enabled());
+	klimt_finish();
+}
+
+static struct callback_head klimt_art_pre_work = { .func = klimt_art_before };
+static struct callback_head klimt_art_post_work = { .func = klimt_art_after };
