 static void klimt_art_after(struct callback_head *work)
 {
-	pr_notice("KLIMT-ART checked run=%s art_pid=%d odr_pid=%d flags=%u ram=%u cache_absent=%u enforcing=%u\n",
-		  klimt_run, READ_ONCE(klimt_boot_pid), READ_ONCE(klimt_odrefresh_pid),
-		  klimt_art_ready, klimt_ram_data(), klimt_cache_absent(), enforcing_enabled());
+	klimt_art_ok = READ_ONCE(klimt_boot_pid) && READ_ONCE(klimt_odrefresh_pid) &&
+		       klimt_art_ready && klimt_ram_data() && klimt_cache_absent() &&
+		       enforcing_enabled();
+	pr_notice("KLIMT-ZYGOTE ART ready=%u\n", klimt_art_ok);
+	if (!klimt_art_ok)
+		klimt_finish();
+}
+
+static void klimt_zygote_cache(struct callback_head *work)
+{
+	struct path path;
+	int error = kern_path("/data/misc/apexdata/com.android.art/dalvik-cache/cache-info.xml",
+			      LOOKUP_NO_SYMLINKS, &path);
+	bool ok = false;
+
+	if (!error) {
+		struct inode *inode = d_inode(path.dentry);
+
+		ok = inode->i_sb->s_magic == TMPFS_MAGIC && S_ISREG(inode->i_mode) &&
+		     i_size_read(inode) > 0;
+		path_put(&path);
+	}
+	pr_notice("KLIMT-ZYGOTE cache_present=%u prior_art=%u error=%d\n", ok, klimt_art_ok, error);
+	if (!ok || !klimt_art_ok)
+		klimt_finish();
+}
+
+static void klimt_zygote_end(struct callback_head *work)
+{
+	struct task_struct *p;
+	int server = 0;
+	char comm[TASK_COMM_LEN];
+
+	rcu_read_lock();
+	for_each_process(p) {
+		get_task_comm(comm, p);
+		if (!strcmp(comm, "system_server")) {
+			server = task_tgid_nr(p);
+			break;
+		}
+	}
+	rcu_read_unlock();
+	pr_notice("KLIMT-ZYGOTE checked run=%s zygote=%d system_server=%d enforcing=%u\n",
+		  klimt_run, READ_ONCE(klimt_zygote_pid), server, enforcing_enabled());
 	klimt_finish();
 }
 
+static struct callback_head klimt_zygote_cache_work = { .func = klimt_zygote_cache };
+static struct callback_head klimt_zygote_end_work = { .func = klimt_zygote_end };
 static struct callback_head klimt_art_pre_work = { .func = klimt_art_before };
 static struct callback_head klimt_art_post_work = { .func = klimt_art_after };
 
