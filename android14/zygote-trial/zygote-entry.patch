-		task_work_add(current, &klimt_art_post_work, TWA_RESUME);
-	snprintf(expected, sizeof(expected), "KLIMT-ART SKIP %s", klimt_run);
+	snprintf(expected, sizeof(expected),
+		 "KLIMT-ART END %s log=version=1,boot=ok,server=ok", klimt_run);
 	if (sysfs_streq(line, expected))
 		task_work_add(current, &klimt_art_post_work, TWA_RESUME);
+	snprintf(expected, sizeof(expected), "KLIMT-ZYGOTE CACHE %s", klimt_run);
+	if (sysfs_streq(line, expected))
+		task_work_add(current, &klimt_zygote_cache_work, TWA_RESUME);
+	snprintf(expected, sizeof(expected), "KLIMT-ZYGOTE END %s log=", klimt_run);
+	if (str_has_prefix(line, expected))
+		task_work_add(current, &klimt_zygote_end_work, TWA_RESUME);
+	snprintf(expected, sizeof(expected), "KLIMT-ZYGOTE SKIP %s", klimt_run);
+	if (sysfs_streq(line, expected))
+		task_work_add(current, &klimt_zygote_end_work, TWA_RESUME);
