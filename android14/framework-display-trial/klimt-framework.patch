--- a/klimt-zygote.rc
+++ b/klimt-zygote.rc
@@ -1,4 +1,6 @@
 import /system/etc/init/logd.rc
+import /system/etc/init/installd.rc
+import /system/etc/init/idmap2d.rc
 
 on early-init
     export ANDROID_BOOTLOGO 1
@@ -36,7 +38,11 @@
     mount binder binder /dev/binderfs stats=global
     chmod 0755 /dev/binderfs
     symlink /dev/binderfs/binder /dev/binder
+    symlink /dev/binderfs/hwbinder /dev/hwbinder
+    symlink /dev/binderfs/vndbinder /dev/vndbinder
     chmod 0666 /dev/binderfs/binder
+    chmod 0666 /dev/binderfs/hwbinder
+    chmod 0666 /dev/binderfs/vndbinder
     start servicemanager
     wait_for_prop servicemanager.ready true
     write /dev/kmsg "KLIMT-FACTORY BOOTSTRAP ${ro.boot.klimt_trial} status=${apexd.status:-unset}"
@@ -105,8 +111,28 @@
     write /dev/kmsg "KLIMT-ZYGOTE CACHE ${ro.boot.klimt_trial}"
 
 on init && property:ro.boot.klimt_zygote=1
+    mkdir /data/app 0771 system system encryption=None
+    mkdir /data/misc/installd 0700 root root
+    mkdir /data/misc/user 0771 root root
+    mkdir /data/resource-cache 0771 system system encryption=None
+    mkdir /data/system_ce 0770 system system encryption=None
+    mkdir /data/system_ce/0 0770 system system
+    mkdir /data/system_de 0770 system system encryption=None
+    mkdir /data/system_de/0 0770 system system
+    start hwservicemanager
+    wait_for_prop hwservicemanager.ready true
+    start vndservicemanager
+    start installd
+    start idmap2d
+    start vendor.hwcomposer-2-1
+    start surfaceflinger
     start zygote
     exec_start klimt-zygote-log
+    exec_start klimt-display-log
+    write /dev/kmsg "KLIMT-DISPLAY ${ro.boot.klimt_trial} hwsm=${hwservicemanager.ready:-unset} hwc=${init.svc.vendor.hwcomposer-2-1:-unset} sf=${init.svc.surfaceflinger:-unset} binder=${debug.klimt_framework_binder:-unset}"
+    write /dev/kmsg "KLIMT-DISPLAY HWC ${debug.klimt_hwc_error:-unreported}"
+    write /dev/kmsg "KLIMT-DISPLAY SF ${debug.klimt_sf_error:-unreported}"
+    write /dev/kmsg "KLIMT-FRAMEWORK INSTALLD state=${init.svc.installd:-unset} detail=${debug.klimt_installd_error:-unreported}"
     write /dev/kmsg "KLIMT-ZYGOTE DETAIL ${ro.boot.klimt_trial} ${debug.klimt_zygote_detail:-unreported}"
     write /dev/kmsg "KLIMT-ZYGOTE END ${ro.boot.klimt_trial} log=${debug.klimt_zygote_log:-unset}"
 
@@ -204,15 +230,62 @@
     disabled
     oneshot
 
-service klimt-zygote-log /system/bin/sh -c /system/bin/toybox\ sleep\ 16;\
+service klimt-zygote-log /system/bin/sh -c /system/bin/toybox\ sleep\ 22;\
         log=$$(/system/bin/logcat\ -b\ system\ -b\ main\ -d\ -v\ raw\ -s\ SystemServer:I\ Zygote:I\ AndroidRuntime:E\ art:I)\ ||\ exit\ 22;\
         case\ \"$$log\"\ in\ *\"Entered\ the\ Android\ system\ server!\"*)\ server=entered\ ;;\ *)\ server=unconfirmed\ ;;\ esac;\
         case\ \"$$log\"\ in\ *\"System\ server\ process\ \"*\"has\ been\ created\"*)\ fork=1\ ;;\ *)\ fork=0\ ;;\ esac;\
         failure=$$(printf\ '%s\\n'\ \"$$log\"\ |\ /system/bin/toybox\ grep\ -m\ 1\ -Ei\ \"exception|failure|failed|abort\"\ |\ /system/bin/toybox\ cut\ -c1-85);\
         /system/bin/setprop\ debug.klimt_zygote_detail\ \"$$failure\"\ ||\ exit\ 23;\
-        /system/bin/setprop\ debug.klimt_zygote_log\ \"server=$$server,fork=$$fork\"
+        /system/bin/setprop\ debug.klimt_zygote_log\ \"server=$$server,fork=$$fork\";\
+        services=$$(/system/bin/toybox\ timeout\ 5\ /system/bin/service\ list)\ ||\ exit\ 22;\
+        case\ \"$$services\"\ in\ *\"activity:\"*)\ activity=1\ ;;\ *)\ activity=0\ ;;\ esac;\
+        case\ \"$$services\"\ in\ *\"package:\"*)\ package=1\ ;;\ *)\ package=0\ ;;\ esac;\
+        case\ \"$$services\"\ in\ *\"window:\"*)\ window=1\ ;;\ *)\ window=0\ ;;\ esac;\
+        case\ \"$$services\"\ in\ *\"SurfaceFlinger:\"*)\ display=1\ ;;\ *)\ display=0\ ;;\ esac;\
+        /system/bin/setprop\ debug.klimt_framework_binder\ \"activity=$$activity,package=$$package,window=$$window,sf=$$display\"
     user shell
     group shell log readproc
     seclabel u:r:shell:s0
     disabled
     oneshot
+
+service klimt-display-log /system/bin/sh -c hwc=$$(/system/bin/logcat\ -b\ main\ -b\ system\ -d\ -v\ raw\ -s\ hwcomposer:W\ ComposerHal:W\ android.hardware.graphics.composer@2.1-service:W\ |\ /system/bin/toybox\ grep\ -m\ 1\ -v\ ^---------\ |\ /system/bin/toybox\ cut\ -c1-86);\
+        sf=$$(/system/bin/logcat\ -b\ main\ -b\ system\ -d\ -v\ raw\ -s\ SurfaceFlinger:W\ EGL:W\ libEGL:W\ |\ /system/bin/toybox\ grep\ -m\ 1\ -v\ ^---------\ |\ /system/bin/toybox\ cut\ -c1-86);\
+        installd=$$(/system/bin/logcat\ -b\ main\ -b\ system\ -d\ -v\ raw\ -s\ installd:W\ |\ /system/bin/toybox\ grep\ -m\ 1\ -v\ ^---------\ |\ /system/bin/toybox\ cut\ -c1-86);\
+        /system/bin/setprop\ debug.klimt_hwc_error\ \"$$hwc\"\ ||\ exit\ 23;\
+        /system/bin/setprop\ debug.klimt_sf_error\ \"$$sf\"\ ||\ exit\ 24;\
+        /system/bin/setprop\ debug.klimt_installd_error\ \"$$installd\"
+    user shell
+    group shell log readproc
+    seclabel u:r:shell:s0
+    disabled
+    oneshot
+
+
+service hwservicemanager /system/system_ext/bin/hwservicemanager
+    user system
+    group system readproc
+    disabled
+    oneshot
+
+service vndservicemanager /vendor/bin/vndservicemanager /dev/vndbinder
+    user system
+    group system readproc
+    file /dev/kmsg w
+    disabled
+    oneshot
+
+service vendor.hwcomposer-2-1 /vendor/bin/hw/android.hardware.graphics.composer@2.1-service
+    interface android.hardware.graphics.composer@2.1::IComposer default
+    user system
+    group graphics drmrpc
+    capabilities SYS_NICE
+    disabled
+    oneshot
+
+service surfaceflinger /system/bin/surfaceflinger
+    user system
+    group graphics drmrpc readproc
+    capabilities SYS_NICE
+    disabled
+    oneshot
