--- a/system/etc/init/logd.rc
+++ b/system/etc/init/logd.rc
@@ -43,3 +43,10 @@
     mkdir /data/misc/bluetooth 0770 bluetooth bluetooth
     mkdir /data/misc/bluetooth/logs 0770 bluetooth bluetooth
     write /dev/kmsg "KLIMT-HOME Bluetooth log directories initialized"
+
+# Load the installed LineageOS USB port HAL in this minimal init configuration.
+import /vendor/etc/init/android.hardware.usb@1.3-service.basic.rc
+on init && property:ro.boot.klimt_zygote=1
+    start vendor.usb-hal-1-3
+on property:init.svc.vendor.usb-hal-1-3=running
+    write /dev/kmsg "KLIMT-HOME USB_HAL running"
