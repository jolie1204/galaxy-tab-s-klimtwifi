@@ -33,6 +33,25 @@
     /system/bin/toybox timeout -k 2 "$@"
 }

+collect_hwc_scanout() {
+    timeout 490 /system/bin/logcat -T 1 -v raw -s KlimtHwcFrame:V |
+        while IFS=' ' read -r kind stamp fb size planes lit preview; do
+            if [ "$kind" != scanout ]; then
+                case "$kind" in
+                    mmap|sync|invalid) "$property" debug.klimt_diag_35 "HWC_READ_ERROR $kind $stamp $fb $size" ;;
+                esac
+                continue
+            fi
+            bits=${preview#preview=}
+            [ "${#bits}" -eq 96 ] || continue
+            first=$(printf '%s' "$bits" | /system/bin/toybox cut -c1-48)
+            second=$(printf '%s' "$bits" | /system/bin/toybox cut -c49-96)
+            "$property" debug.klimt_diag_35 "HWC_FRAME $stamp $fb $size $planes $lit"
+            "$property" debug.klimt_diag_33 "HWC_PIXELS0 $stamp $first"
+            "$property" debug.klimt_diag_34 "HWC_PIXELS1 $stamp $second"
+        done
+}
+
 cycle=0
 while [ "$cycle" -lt 60 ]; do
     cycle=$((cycle + 1))
