+static bool klimt_exports_absent(void)
+{
+	struct path path;
+	int err = kern_path(klimt_exports, LOOKUP_NO_SYMLINKS, &path);
+
+	if (!err)
+		path_put(&path);
+	return err == -ENOENT;
+}
+
+static void klimt_cp_before(struct callback_head *work)
+{
+	bool absent = klimt_exports_absent();
+
+	klimt_before_ok = absent && klimt_base_ok && klimt_ram_data();
+	pr_notice("KLIMT-CP clean=%u absent=%u base=%u\n",
+		  klimt_before_ok, absent, klimt_base_ok);
+	if (!klimt_before_ok)
+		klimt_finish();
+}
+
+static void klimt_cp_skip(struct callback_head *work)
+{
+	pr_notice("KLIMT-CP SKIPPED run=%s absent=%u base=%u\n",
+		  klimt_run, klimt_exports_absent(), klimt_base_ok && klimt_before_ok);
+	klimt_finish();
+}
