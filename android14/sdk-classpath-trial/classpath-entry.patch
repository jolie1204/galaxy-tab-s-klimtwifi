+static bool klimt_jar_exists(const char *name)
+{
+	struct path path;
+	size_t length = strlen(name);
+	bool valid;
+
+	if (length < 5 || strcmp(name + length - 4, ".jar") ||
+	    (!str_has_prefix(name, "/apex/") && !str_has_prefix(name, "/system/framework/")) ||
+	    kern_path(name, LOOKUP_NO_SYMLINKS, &path))
+		return false;
+	valid = S_ISREG(d_inode(path.dentry)->i_mode) &&
+		i_size_read(d_inode(path.dentry)) > 0;
+	path_put(&path);
+	return valid;
+}
+
+static bool klimt_match_exports(char *text)
+{
+	static const char * const names[] = {
+		"export BOOTCLASSPATH ", "export DEX2OATBOOTCLASSPATH ",
+		"export SYSTEMSERVERCLASSPATH ", "export STANDALONE_SYSTEMSERVER_JARS ",
+	};
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(names); i++) {
+		char *line = strsep(&text, "\n");
+		char *jar;
+		unsigned int count = 0;
+		size_t prefix = line ? str_has_prefix(line, names[i]) : 0;
+
+		if (!prefix)
+			return false;
+		line += prefix;
+		while ((jar = strsep(&line, ":"))) {
+			if (!klimt_jar_exists(jar)) {
+				pr_notice("KLIMT-CP missing_jar=%s\n", jar);
+				return false;
+			}
+			count++;
+		}
+		pr_notice("KLIMT-CP %sjars=%u\n", names[i], count);
+		if (!count)
+			return false;
+	}
+	return text && !*text;
+}
+
+static void klimt_cp_after(struct callback_head *work)
+{
+	const size_t limit = 8192;
+	char *data = NULL;
+	char hex[65] = {};
+	u8 digest[SHA256_DIGEST_SIZE];
+	struct file *file;
+	ssize_t bytes = -EINVAL;
+	loff_t pos = 0;
+	bool parsed = false;
+	bool pass;
+
+	file = filp_open(klimt_exports, O_RDONLY | O_NOFOLLOW, 0);
+	if (!IS_ERR(file)) {
+		data = kmalloc(limit + 1, GFP_KERNEL);
+		if (data && file_inode(file)->i_sb->s_magic == TMPFS_MAGIC &&
+		    S_ISREG(file_inode(file)->i_mode))
+			bytes = kernel_read(file, data, limit, &pos);
+		if (bytes > 0 && bytes < limit && bytes == i_size_read(file_inode(file))) {
+			data[bytes] = '\0';
+			sha256(data, bytes, digest);
+			snprintf(hex, sizeof(hex), "%*phN", SHA256_DIGEST_SIZE, digest);
+			parsed = klimt_match_exports(data);
+		}
+		fput(file);
+	}
+	kfree(data);
+	pass = parsed && !strcmp(hex, klimt_env_sha) && klimt_before_ok &&
+	       klimt_ram_data() && current->nsproxy->mnt_ns == klimt_default_ns &&
+	       enforcing_enabled() && klimt_in_domain("u:r:init:s0");
+	pr_notice("KLIMT-CP %s run=%s bytes=%zd sha256=%s parsed=%u env_match=%u enforcing=%u\n",
+		  pass ? "PASS" : "FAIL", klimt_run, bytes, hex, parsed,
+		  !!hex[0] && !strcmp(hex, klimt_env_sha), enforcing_enabled());
+	klimt_finish();
+}
