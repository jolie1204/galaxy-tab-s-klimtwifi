on property:sys.boot_completed=1
    restorecon /data/local/tmp/klimt-setup-observe.sh
    start klimt-panel-capture

service klimt-panel-capture /system/bin/sh /data/local/tmp/klimt-setup-observe.sh
    user shell
    group shell log readproc input
    seclabel u:r:shell:s0
    disabled
    oneshot
    timeout_period 155
