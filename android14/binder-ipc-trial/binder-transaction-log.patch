+/* Current sender identity, observed on the issuing task. */
+static bool klimt_binder_domain(const char *expected)
+{
+	char *label = NULL;
+	u32 sid, len;
+	bool match;
+
+	security_current_getsecid_subj(&sid);
+	if (security_secid_to_secctx(sid, &label, &len))
+		return false;
+	match = !strcmp(label, expected);
+	security_release_secctx(label, len);
+	return match;
+}
