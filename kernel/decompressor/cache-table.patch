--- a/arch/arm/boot/compressed/head.S
+++ b/arch/arm/boot/compressed/head.S
@@ -879,2 +879,19 @@ __armv7_mmu_cache_on:
-		movne	r6, #CB_BITS | 0x02	@ !XN
-		blne	__setup_mmu
+		movne	r6, #CB_BITS | 0x02	@ !XN
+		blne	__setup_mmu
+		/* Only the first cache_on call has scratch r9 and a known return PC. */
+		tst	r11, #0xf
+		beq	.Lklimt_table_done
+		adr_l	r0, .Lklimt_cache_return
+		cmp	r12, r0
+		bne	.Lklimt_table_done
+		sub	r0, r4, #16384
+		cmp	r0, r3			@ require an exactly aligned destination
+		bne	.Lklimt_table_done
+		mov	r9, r3
+		bl	.Lklimt_entry_fn	@ validates incoming translations and signature
+.Lklimt_table_return:
+		mov	r3, r9
+		add	r4, r3, #16384
+		adr_l	r12, .Lklimt_cache_return
+		mrc	p15, 0, r11, c0, c1, 4	@ restore ID_MMFR0 for the stock path
+.Lklimt_table_done:
