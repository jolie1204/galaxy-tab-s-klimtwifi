+int samsung_dsim_prepare_klimt_panel(struct mipi_dsi_device *panel)
+{
+	struct samsung_dsim *dsi;
+	u32 stop, status;
+	int ret;
+
+	if (panel->host->ops != &samsung_dsim_ops)
+		return -ENODEV;
+
+	dsi = host_to_dsi(panel->host);
+	if (!dsi->exynos5420_mic || !(dsi->state & DSIM_STATE_ENABLED))
+		return -EINVAL;
+
+	ret = samsung_dsim_init(dsi);
+	if (ret)
+		return ret;
+
+	stop = DSIM_STOP_STATE_CLK | DSIM_STOP_STATE_DAT(BIT(dsi->lanes) - 1);
+	ret = read_poll_timeout(samsung_dsim_read, status, (status & stop) == stop,
+				10, 5000, false, dsi, DSIM_STATUS_REG);
+	dev_info(dsi->dev, "KLIMT-DSIM LP11 before reset ret=%d status=%#x clk=%#x\n",
+		 ret, status, samsung_dsim_read(dsi, DSIM_CLKCTRL_REG));
+	return ret;
+}
+EXPORT_SYMBOL_GPL(samsung_dsim_prepare_klimt_panel);
