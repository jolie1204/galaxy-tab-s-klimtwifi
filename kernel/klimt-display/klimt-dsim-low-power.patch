--- a/drivers/gpu/drm/bridge/samsung-dsim.c
+++ b/drivers/gpu/drm/bridge/samsung-dsim.c
@@ -1033,7 +1033,9 @@
 
 	reg = samsung_dsim_read(dsi, DSIM_ESCMODE_REG);
 	reg &= ~DSIM_STOP_STATE_CNT_MASK;
-	reg |= DSIM_STOP_STATE_CNT(driver_data->reg_values[STOP_STATE_CNT]);
+	/* Stock Klimt readback uses one escape-clock cycle. */
+	reg |= DSIM_STOP_STATE_CNT(dsi->exynos5420_mic ? 1 :
+				  driver_data->reg_values[STOP_STATE_CNT]);
 	samsung_dsim_write(dsi, DSIM_ESCMODE_REG, reg);
 
 	reg = DSIM_BTA_TIMEOUT(0xff) | DSIM_LPDR_TIMEOUT(0xffff);
@@ -1952,8 +1954,7 @@
 		return ret;
 
 	if (dsi->exynos5420_mic && dsi->mode.clock &&
-	    msg->type == MIPI_DSI_DCS_READ && msg->tx_len == 1 &&
-	    ((const u8 *)msg->tx_buf)[0] == MIPI_DCS_GET_DISPLAY_ID &&
+	    msg->type == MIPI_DSI_SET_MAXIMUM_RETURN_PACKET_SIZE &&
 	    !(dsi->state & DSIM_STATE_VIDOUT_AVAILABLE)) {
 		samsung_dsim_set_display_mode(dsi);
 		samsung_dsim_set_display_enable(dsi, true);
@@ -1964,6 +1965,18 @@
 			 readl(dsi->reg_base + EXYNOS5420_DSIM_MIC_CTRL));
 	}
 
+	if (dsi->exynos5420_mic && msg->type == MIPI_DSI_DCS_READ &&
+	    msg->tx_len == 1 &&
+	    ((const u8 *)msg->tx_buf)[0] == MIPI_DCS_GET_DISPLAY_ID)
+		dev_info(dsi->dev,
+			 "KLIMT-DSIM before ID status=%#x clk=%#x timeout=%#x esc=%#x mask=%#x pll=%#x\n",
+			 samsung_dsim_read(dsi, DSIM_STATUS_REG),
+			 samsung_dsim_read(dsi, DSIM_CLKCTRL_REG),
+			 samsung_dsim_read(dsi, DSIM_TIMEOUT_REG),
+			 samsung_dsim_read(dsi, DSIM_ESCMODE_REG),
+			 samsung_dsim_read(dsi, DSIM_INTMSK_REG),
+			 samsung_dsim_read(dsi, DSIM_PLLCTRL_REG));
+
 	ret = mipi_dsi_create_packet(&xfer.packet, msg);
 	if (ret < 0)
 		return ret;
--- a/arch/arm/boot/dts/samsung/exynos5420-klimt-wifi.dts
+++ b/arch/arm/boot/dts/samsung/exynos5420-klimt-wifi.dts
@@ -89,7 +89,7 @@
 	vddcore-supply = <&ldo6_reg>;
 	vddio-supply = <&ldo7_reg>;
 	samsung,burst-clock-frequency = <512000000>;
-	samsung,esc-clock-frequency = <12800000>;
+	samsung,esc-clock-frequency = <8000000>;
 	samsung,pll-clock-frequency = <24000000>;
 	status = "okay";
 
