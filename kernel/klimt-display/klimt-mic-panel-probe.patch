diff --git a/drivers/gpu/drm/panel/panel-samsung-s6e3ha1-probe.c b/drivers/gpu/drm/panel/panel-samsung-s6e3ha1-probe.c
new file mode 100644
index 0000000..4b5c930
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-samsung-s6e3ha1-probe.c
@@ -0,0 +1,207 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* SM-T700 S6E3HA1 link probe. No display-on or brightness commands. */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#include <drm/drm_connector.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+
+struct s6e3ha1_probe {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct gpio_desc *reset;
+	struct regulator *vdd3;
+	struct regulator *vci;
+	struct regulator *vddr;
+};
+
+static inline struct s6e3ha1_probe *to_s6e3ha1(struct drm_panel *panel)
+{
+	return container_of(panel, struct s6e3ha1_probe, panel);
+}
+
+static const struct drm_display_mode klimt_panel_mode = {
+	.clock = 251160,
+	.hdisplay = 1600,
+	.hsync_start = 1610,
+	.hsync_end = 1615,
+	.htotal = 1625,
+	.vdisplay = 2560,
+	.vsync_start = 2571,
+	.vsync_end = 2572,
+	.vtotal = 2576,
+	.width_mm = 113,
+	.height_mm = 180,
+	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+static int s6e3ha1_power_off(struct drm_panel *panel)
+{
+	struct s6e3ha1_probe *ctx = to_s6e3ha1(panel);
+
+	regulator_disable(ctx->vddr);
+	usleep_range(5000, 6000);
+	regulator_disable(ctx->vci);
+	regulator_disable(ctx->vdd3);
+	gpiod_set_value_cansleep(ctx->reset, 1);
+
+	return 0;
+}
+
+static int s6e3ha1_read_id(struct drm_panel *panel)
+{
+	struct s6e3ha1_probe *ctx = to_s6e3ha1(panel);
+	struct device *dev = &ctx->dsi->dev;
+	u8 id[3];
+	int ret;
+
+	ret = regulator_enable(ctx->vdd3);
+	if (ret)
+		return ret;
+
+	ret = regulator_enable(ctx->vci);
+	if (ret)
+		goto disable_vdd3;
+
+	usleep_range(5000, 6000);
+	ret = regulator_enable(ctx->vddr);
+	if (ret)
+		goto disable_vci;
+
+	msleep(30);
+	gpiod_set_value_cansleep(ctx->reset, 0);
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(ctx->reset, 1);
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(ctx->reset, 0);
+	usleep_range(10000, 15000);
+
+	ret = mipi_dsi_set_maximum_return_packet_size(ctx->dsi, sizeof(id));
+	if (ret < 0)
+		goto disable_rails;
+
+	ret = mipi_dsi_dcs_read(ctx->dsi, 0x04, id, sizeof(id));
+	if (ret != sizeof(id)) {
+		dev_err(dev, "KLIMT-PANEL display ID read returned %d\n", ret);
+		if (ret >= 0)
+			ret = -EIO;
+		goto disable_rails;
+	}
+
+	dev_info(dev, "KLIMT-PANEL display ID %3phC\n", id);
+	if (id[0] != 0x42 || id[1] != 0x11 || id[2] != 0x03) {
+		ret = -ENODEV;
+		goto disable_rails;
+	}
+
+	return 0;
+
+disable_rails:
+	s6e3ha1_power_off(panel);
+	return ret;
+disable_vci:
+	regulator_disable(ctx->vci);
+disable_vdd3:
+	regulator_disable(ctx->vdd3);
+	return ret;
+}
+
+static int s6e3ha1_get_modes(struct drm_panel *panel,
+			    struct drm_connector *connector)
+{
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &klimt_panel_mode);
+	if (!mode)
+		return -ENOMEM;
+
+	drm_mode_set_name(mode);
+	drm_mode_probed_add(connector, mode);
+	connector->display_info.width_mm = mode->width_mm;
+	connector->display_info.height_mm = mode->height_mm;
+
+	return 1;
+}
+
+static const struct drm_panel_funcs s6e3ha1_panel_funcs = {
+	.prepare = s6e3ha1_read_id,
+	.unprepare = s6e3ha1_power_off,
+	.get_modes = s6e3ha1_get_modes,
+};
+
+static int s6e3ha1_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct s6e3ha1_probe *ctx;
+	int ret;
+
+	ctx = devm_kzalloc(dev, sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+
+	ctx->dsi = dsi;
+	ctx->vdd3 = devm_regulator_get(dev, "vdd3");
+	if (IS_ERR(ctx->vdd3))
+		return dev_err_probe(dev, PTR_ERR(ctx->vdd3), "failed to get vdd3\n");
+
+	ctx->vci = devm_regulator_get(dev, "vci");
+	if (IS_ERR(ctx->vci))
+		return dev_err_probe(dev, PTR_ERR(ctx->vci), "failed to get vci\n");
+
+	ctx->vddr = devm_regulator_get(dev, "vddr");
+	if (IS_ERR(ctx->vddr))
+		return dev_err_probe(dev, PTR_ERR(ctx->vddr), "failed to get vddr\n");
+
+	ctx->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset), "failed to get reset\n");
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+			  MIPI_DSI_MODE_VIDEO_NO_HFP | MIPI_DSI_MODE_NO_EOT_PACKET |
+			  MIPI_DSI_MODE_LPM;
+
+	drm_panel_init(&ctx->panel, dev, &s6e3ha1_panel_funcs, DRM_MODE_CONNECTOR_DSI);
+	ctx->panel.prepare_prev_first = true;
+	drm_panel_add(&ctx->panel);
+	mipi_dsi_set_drvdata(dsi, ctx);
+	ret = mipi_dsi_attach(dsi);
+	if (ret)
+		drm_panel_remove(&ctx->panel);
+
+	return ret;
+}
+
+static void s6e3ha1_remove(struct mipi_dsi_device *dsi)
+{
+	struct s6e3ha1_probe *ctx = mipi_dsi_get_drvdata(dsi);
+
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id s6e3ha1_match[] = {
+	{ .compatible = "samsung,klimt-s6e3ha1-probe" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, s6e3ha1_match);
+
+static struct mipi_dsi_driver s6e3ha1_driver = {
+	.probe = s6e3ha1_probe,
+	.remove = s6e3ha1_remove,
+	.driver = {
+		.name = "panel-samsung-s6e3ha1-probe",
+		.of_match_table = s6e3ha1_match,
+	},
+};
+module_mipi_dsi_driver(s6e3ha1_driver);
+
+MODULE_DESCRIPTION("Samsung Klimt S6E3HA1 panel link probe");
+MODULE_LICENSE("GPL");
