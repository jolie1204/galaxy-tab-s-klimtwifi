diff --git a/drivers/gpu/drm/bridge/samsung-dsim.c b/drivers/gpu/drm/bridge/samsung-dsim.c
index 9e494c4..a1e9981 100644
--- a/drivers/gpu/drm/bridge/samsung-dsim.c
+++ b/drivers/gpu/drm/bridge/samsung-dsim.c
@@ -648,6 +648,31 @@ static unsigned long samsung_dsim_pll_find_pms(struct samsung_dsim *dsi,
 	return best_freq;
 }
 
+static bool samsung_dsim_has_5420_phy_timings(struct samsung_dsim *dsi,
+					     unsigned long rate)
+{
+	return dsi->plat_data->hw_type == DSIM_TYPE_EXYNOS5420 &&
+	       rate == 512 * MHZ;
+}
+
+static void exynos5420_dsim_set_phy_timings(struct samsung_dsim *dsi)
+{
+	const unsigned int *values = dsi->driver_data->reg_values;
+
+	samsung_dsim_write(dsi, DSIM_PHYCTRL_REG, values[PHYCTRL_ULPS_EXIT]);
+	samsung_dsim_write(dsi, DSIM_PHYTIMING_REG,
+			   values[PHYTIMING_LPX] | values[PHYTIMING_HS_EXIT]);
+	samsung_dsim_write(dsi, DSIM_PHYTIMING1_REG,
+			   values[PHYTIMING_CLK_PREPARE] |
+			   values[PHYTIMING_CLK_ZERO] |
+			   values[PHYTIMING_CLK_POST] |
+			   values[PHYTIMING_CLK_TRAIL]);
+	samsung_dsim_write(dsi, DSIM_PHYTIMING2_REG,
+			   values[PHYTIMING_HS_PREPARE] |
+			   values[PHYTIMING_HS_ZERO] |
+			   values[PHYTIMING_HS_TRAIL]);
+}
+
 static unsigned long samsung_dsim_set_pll(struct samsung_dsim *dsi,
 					  unsigned long freq)
 {
@@ -712,6 +737,9 @@ static unsigned long samsung_dsim_set_pll(struct samsung_dsim *dsi,
 	if (dsi->swap_dn_dp_data)
 		reg |= DSIM_PLL_DPDNSWAP_DAT;
 
+	if (samsung_dsim_has_5420_phy_timings(dsi, fout))
+		exynos5420_dsim_set_phy_timings(dsi);
+
 	samsung_dsim_write(dsi, DSIM_PLLCTRL_REG, reg);
 
 	timeout = 1000;
@@ -787,7 +815,8 @@ static void samsung_dsim_set_phy_ctrl(struct samsung_dsim *dsi)
 	int hs_exit, hs_prepare, hs_zero, hs_trail;
 	unsigned long long byte_clock = dsi->hs_clock / 8;
 
-	if (driver_data->has_freqband)
+	if (driver_data->has_freqband ||
+	    samsung_dsim_has_5420_phy_timings(dsi, dsi->hs_clock))
 		return;
 
 	phy_mipi_dphy_get_default_config_for_hsclk(dsi->hs_clock,
@@ -1506,7 +1535,23 @@ static int samsung_dsim_init(struct samsung_dsim *dsi)
 	if (driver_data->wait_for_reset)
 		samsung_dsim_wait_for_reset(dsi);
 	samsung_dsim_set_phy_ctrl(dsi);
-	samsung_dsim_init_link(dsi);
+	if (dsi->exynos5420_mic) {
+		int error = samsung_dsim_init_link(dsi);
+
+		dev_info(dsi->dev,
+			 "KLIMT-DSIM link=%d hs=%u status=%#x clk=%#x esc=%#x\n",
+			 error, dsi->hs_clock,
+			 samsung_dsim_read(dsi, DSIM_STATUS_REG),
+			 samsung_dsim_read(dsi, DSIM_CLKCTRL_REG),
+			 samsung_dsim_read(dsi, DSIM_ESCMODE_REG));
+		dev_info(dsi->dev, "KLIMT-DSIM phy=%#x timing=%#x/%#x/%#x\n",
+			 samsung_dsim_read(dsi, DSIM_PHYCTRL_REG),
+			 samsung_dsim_read(dsi, DSIM_PHYTIMING_REG),
+			 samsung_dsim_read(dsi, DSIM_PHYTIMING1_REG),
+			 samsung_dsim_read(dsi, DSIM_PHYTIMING2_REG));
+	} else {
+		samsung_dsim_init_link(dsi);
+	}
 
 	dsi->state |= DSIM_STATE_INITIALIZED;
 
diff --git a/drivers/gpu/drm/panel/panel-samsung-s6e3ha1-probe.c b/drivers/gpu/drm/panel/panel-samsung-s6e3ha1-probe.c
index 4b5c930..08a55ed 100644
--- a/drivers/gpu/drm/panel/panel-samsung-s6e3ha1-probe.c
+++ b/drivers/gpu/drm/panel/panel-samsung-s6e3ha1-probe.c
@@ -75,12 +75,20 @@ static int s6e3ha1_read_id(struct drm_panel *panel)
 		goto disable_vci;
 
 	msleep(30);
+	/* Exercise the host's link initialization while the panel is in reset. */
+	ret = mipi_dsi_set_maximum_return_packet_size(ctx->dsi, sizeof(id));
+	if (ret < 0) {
+		dev_err(dev, "KLIMT-PANEL link setup returned %d\n", ret);
+		goto disable_rails;
+	}
+
 	gpiod_set_value_cansleep(ctx->reset, 0);
 	usleep_range(1000, 2000);
 	gpiod_set_value_cansleep(ctx->reset, 1);
 	usleep_range(1000, 2000);
 	gpiod_set_value_cansleep(ctx->reset, 0);
 	usleep_range(10000, 15000);
+	usleep_range(18000, 19000);
 
 	ret = mipi_dsi_set_maximum_return_packet_size(ctx->dsi, sizeof(id));
 	if (ret < 0)
@@ -166,7 +174,7 @@ static int s6e3ha1_probe(struct mipi_dsi_device *dsi)
 	dsi->format = MIPI_DSI_FMT_RGB888;
 	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
 			  MIPI_DSI_MODE_VIDEO_NO_HFP | MIPI_DSI_MODE_NO_EOT_PACKET |
-			  MIPI_DSI_MODE_LPM;
+			  MIPI_DSI_MODE_VSYNC_FLUSH;
 
 	drm_panel_init(&ctx->panel, dev, &s6e3ha1_panel_funcs, DRM_MODE_CONNECTOR_DSI);
 	ctx->panel.prepare_prev_first = true;
