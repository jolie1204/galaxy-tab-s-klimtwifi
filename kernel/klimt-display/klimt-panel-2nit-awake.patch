+	dev_info(dev, "KLIMT-PANEL calibrated 2-nit setup complete\n");
+
 	return 0;
 
 disable_rails:
@@ -177,6 +326,8 @@
 
 static const struct drm_panel_funcs s6e3ha1_panel_funcs = {
 	.prepare = s6e3ha1_read_id,
+	.enable = s6e3ha1_enable_fixed_output,
+	.disable = s6e3ha1_disable_output,
 	.unprepare = s6e3ha1_power_off,
 	.get_modes = s6e3ha1_get_modes,
 };
